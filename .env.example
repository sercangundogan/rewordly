# Copy to .env and fill in. Then build: npm run build
# API base (defaults to https://rewordly.store if not set)
API_BASE_URL=https://rewordly.store

# Supabase – required for login in the extension popup
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
